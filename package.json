{
  "name": "naraclip",
  "version": "0.1.0",
  "private": true,
  "description": "NaraClip AI infotainment video platform",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "build:all": "pnpm build && pnpm --filter @naraclip/contracts typecheck && pnpm --filter @naraclip/renderer check",
    "dev": "node ace serve --hmr",
    "dev:renderer": "pnpm --filter @naraclip/renderer dev",
    "test": "node ace test",
    "test:contracts": "pnpm --filter @naraclip/contracts test",
    "lint": "eslint .",
    "lint:renderer": "pnpm --filter @naraclip/renderer lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
    "typecheck:all": "pnpm typecheck && pnpm --filter @naraclip/contracts typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:contracts && pnpm lint:renderer && pnpm --filter @naraclip/renderer check"
  },
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/luxon": "^3.7.4",
    "@types/node": "~26.2.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.4.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/http-transformers": "2.3.1",
    "@adonisjs/inertia": "^5.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.0",
    "@aws-sdk/client-s3": "3.1114.0",
    "@aws-sdk/s3-request-presigner": "3.1114.0",
    "@inertiajs/core": "^3.6.1",
    "@inertiajs/react": "^3.6.1",
    "@naraclip/contracts": "workspace:*",
    "@vinejs/vine": "^4.4.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "bullmq": "5.63.0",
    "edge.js": "^6.5.1",
    "framer-motion": "13.1.1",
    "ioredis": "5.8.2",
    "luxon": "^3.7.2",
    "pg": "8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-react>eslint": "$eslint"
    }
  },
  "allowScripts": {
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  },
  "prettier": "@adonisjs/prettier-config"
}
