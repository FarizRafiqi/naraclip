# Runtime
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

# Application
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Auth session
SESSION_DRIVER=cookie

# PostgreSQL (production and staging)
DB_CONNECTION=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=naraclip
DB_PASSWORD=change-me
DB_DATABASE=naraclip
DB_POOL_MIN=2
DB_POOL_MAX=10

# Cloudflare R2 (S3-compatible private bucket)
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_URL_TTL_SECONDS=900

# CORS
CORS_ORIGIN=http://localhost:3000
