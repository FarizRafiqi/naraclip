# Runtime
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

# Application
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Auth session
SESSION_DRIVER=cookie

# PostgreSQL (production and staging)
DB_CONNECTION=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=naraclip
DB_PASSWORD=change-me
DB_DATABASE=naraclip
DB_POOL_MIN=2
DB_POOL_MAX=10

# Object Storage (MinIO Self-Hosted S3)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=naraclip
MINIO_ACCESS_KEY=naraclipadmin
MINIO_SECRET_KEY=naraclipsecret
MINIO_CONSOLE_PORT=9001
MINIO_SIGNED_URL_TTL_SECONDS=900

# Redis queue (required for worker mode)
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=naraclip

# HTTP
CORS_ORIGIN=http://localhost:3000

# 9Router AI Gateway (Cloud Text-to-Image Aggregator: OpenAI, Gemini, Grok, etc.)
NINEROUTER_ENDPOINT=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=

# ComfyUI Local API (Direct Native Bypass)
COMFYUI_ENDPOINT=http://127.0.0.1:8188
