# Dependencies
node_modules/
.pnpm-store/

# Build & Bundler Output
build/
dist/
public/assets/
.next/
out/
.turbo/
.parcel-cache/
.eslintcache/

# Local Environment & Secrets
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep
!secrets/README.md
client_secret_*.json
*.pem
*.key
*.cert
*:Zone.Identifier
*.Zone.Identifier

# Runtime Data & Databases
tmp/*
!tmp/.gitkeep
database/*.sqlite*
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite-journal
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Video Production & Render Artifacts (Exports, Snapshots, Large Media Outputs)
*.mp4
*.mov
*.avi
*.webm
*.mkv

# Video Content Workspaces (Self-contained local video projects)
# Aturan: Semua aset (visual, audio), data timing, skrip build/mix khusus konten,
# serta hasil render disimpan lokal di dalam packages/hyperframes/content/<slug>/ dan TIDAK di-push ke git.
packages/hyperframes/content/*
!packages/hyperframes/content/.gitkeep
public/content/*
!public/content/.gitkeep

# Media Binaries (Images, Audio, Cutouts)
packages/hyperframes/**/*.png
packages/hyperframes/**/*.jpg
packages/hyperframes/**/*.jpeg
packages/hyperframes/**/*.webp
packages/hyperframes/**/*.gif
packages/hyperframes/**/*.wav
packages/hyperframes/**/*.mp3
packages/hyperframes/**/*.m4a
packages/hyperframes/**/*.ogg
packages/hyperframes/**/*.flac
packages/hyperframes/**/*.aac

# Renderer Dynamic Aliases & Output Links
packages/hyperframes/scripts
packages/hyperframes/snapshots
packages/hyperframes/*.mp4
packages/hyperframes/output_*.mp4
packages/hyperframes/assets/*
!packages/hyperframes/assets/fonts/
!packages/hyperframes/assets/fonts/**
!packages/hyperframes/assets/vendor/
!packages/hyperframes/assets/vendor/**

